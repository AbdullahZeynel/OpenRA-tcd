# Tactics & Command Dynamics dedicated server.
#
#     cp .env.example .env
#
# Compose reads .env from this directory on its own. Every line is optional —
# delete one and docker-compose.yml's default applies. Do not commit your .env;
# it is ignored for a reason, and it can hold a password.

# What the server browser shows. Set this first.
TCD_SERVER_NAME=TCD Dedicated

# The release your players run, and the version this image is built as. A client
# only joins a server reporting its own version string, so this has to match the
# AppImage on the releases page.
TCD_VERSION=release-tcd-0.2.0

# Published and listened-on port. One value: the two cannot differ.
TCD_PORT=1234

# Map UID to pin the lobby to. Empty lets the server choose.
TCD_MAP=

# Empty means anyone can join.
TCD_PASSWORD=

# Register with master.openra.net so the server appears in the in-game browser.
# False makes it reachable by address only.
TCD_ADVERTISE_ONLINE=True

# Restrict the lobby to players with an OpenRA forum account.
TCD_REQUIRE_AUTHENTICATION=False

# Let a single player start a game alone.
TCD_ENABLE_SINGLEPLAYER=False

# Replays are written into the container's volume and never cleaned up.
TCD_RECORD_REPLAYS=False
